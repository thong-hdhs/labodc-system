{
  "name": "labodc-system",
  "version": "1.0.0",
  "private": true,
  "description": "LabOdc - Enterprise-Student Collaboration Platform at UTH",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}